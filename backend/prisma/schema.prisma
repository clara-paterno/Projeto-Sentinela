generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//enums
enum TipoSolicitacao{
  DENUNCIA
  OCORRENCIA
}

enum StatusSolicitacao{
  RECEBIDA
  EM_ANALISE
  EM_ATENDIMENTO
  CONCLUIDA
  ENCERRADA_SEM_ATENDIMENTO
}

//models 
model Categoria{
  id String @id @default(uuid()) @db.Uuid
  nome String
  descricao String
  tipo TipoSolicitacao 
  ativa Boolean @default(true)
  criadaEm DateTime @default(now())
  @@unique([nome,tipo])
  solicitacoes Solicitacao[] 
}

model Solicitacao{
  //IDs
  id String @id @default(uuid()) @db.Uuid
  protocolo String @unique
  codigoConsultaHash String

  //classificação
  tipo TipoSolicitacao
  status StatusSolicitacao @default(RECEBIDA)
  anonima Boolean @default(false)
  categoriaId String @db.Uuid
  categoria Categoria @relation(fields: [categoriaId], references: [id])
  descricao String

  //endereço
  latitude Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  enderecoOcorrencia String?

  // dados solicitante
  solicitanteNome String?
  solicitanteEmail String?
  solicitanteTelefone String?
  solicitanteEnderecoResidencial String?

  // Pessoa envolvida (opcional)
  envolvidoNome      String?
  envolvidoEndereco  String?
  envolvidoDescricao String?

  //datas
  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt
}