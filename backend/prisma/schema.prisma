generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//enums
enum TipoSolicitacao{
  DENUNCIA
  OCORRENCIA
}

enum StatusSolicitacao{
  RECEBIDA
  EM_ANALISE
  EM_ATENDIMENTO
  CONCLUIDA
  ENCERRADA_SEM_ATENDIMENTO
}

//models 
model Categoria{
  id String @id @default(uuid()) @db.Uuid
  nome String
  descricao String
  tipo TipoSolicitacao 
  ativa Boolean @default(true)
  criadaEm DateTime @default(now())
  @@unique([nome,tipo])
  solicitacoes Solicitacao[] 
}

model Solicitacao{
  //IDs
  id String @id @default(uuid()) @db.Uuid
  protocolo String @unique
  codigoConsultaHash String

  //classificação
  tipo TipoSolicitacao
  status StatusSolicitacao @default(RECEBIDA)
  anonima Boolean @default(false)
  categoriaId String @db.Uuid
  categoria Categoria @relation(fields: [categoriaId], references: [id])
  descricao String

  //endereço
  latitude Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  enderecoOcorrencia String?

  // dados solicitante
  solicitanteNome String?
  solicitanteEmail String?
  solicitanteTelefone String?
  solicitanteEnderecoResidencial String?

  // Pessoa envolvida (opcional)
  envolvidoNome      String?
  envolvidoEndereco  String?
  envolvidoDescricao String?

  //datas
  criadaEm     DateTime @default(now())
  atualizadaEm DateTime @updatedAt

  historicoStatus HistoricoStatus[]
  anexos Anexo[]

}

model Agente {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String
  email     String   @unique
  senhaHash String
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  historicoStatus HistoricoStatus[]

}

model HistoricoStatus {
  id String @id @default(uuid()) @db.Uuid
  solicitacaoId String @db.Uuid
  agenteId String @db.Uuid
  statusAnterior StatusSolicitacao
  statusNovo StatusSolicitacao
  observacao String?
  criadoEm DateTime @default(now())

  solicitacao Solicitacao @relation(fields: [solicitacaoId], references: [id])
  agente      Agente      @relation(fields: [agenteId], references: [id])

} 

model Anexo {
  id String @id @default(uuid()) @db.Uuid
  solicitacaoId String @db.Uuid
  url String
  nomeOriginal String?
  mineType String
  tamanhoBytes Int
  criadoEm DateTime @default(now())

  solicitacao Solicitacao @relation(fields: [solicitacaoId], references: [id])
}